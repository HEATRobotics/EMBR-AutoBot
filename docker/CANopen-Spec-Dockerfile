# Dedicated ROS 2 Humble environment for CANopen simulation.
FROM ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=humble \
    EMBR_PHYS_WS=/workspace/embr_phys_ws \
    EMBR_SIM_WS=/workspace/embr_sim_ws

SHELL ["/bin/bash", "-c"]

ARG USERNAME=embr
ARG USER_UID=1000
ARG USER_GID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
        can-utils \
        git \
        iproute2 \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-serial \
        ros-humble-ament-cmake \
        ros-humble-canopen \
        ros-humble-canopen-fake-slaves \
        ros-humble-canopen-ros2-control \
        ros-humble-canopen-ros2-controllers \
        ros-humble-joint-state-publisher-gui \
        ros-humble-robot-state-publisher \
        ros-humble-ros-gz \
        ros-humble-ros2-control \
        ros-humble-ros2-controllers \
        ros-humble-rviz2 \
        ros-humble-xacro \
        ros-humble-rqt \
        ros-humble-rqt-common-plugins \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "${USER_GID}" "${USERNAME}" \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home \
        --shell /bin/bash "${USERNAME}"

WORKDIR /workspace

# Cache dependency installation and validate an initial build. Copy only source
# packages so host-generated build/install/log artifacts never enter the image.
COPY --chown=${USER_UID}:${USER_GID} embr_phys/ros2_ws/src/ ${EMBR_PHYS_WS}/src/
COPY --chown=${USER_UID}:${USER_GID} embr_sim/ros2_ws/src/ ${EMBR_SIM_WS}/src/
RUN apt-get update \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && rosdep install --from-paths ${EMBR_PHYS_WS}/src ${EMBR_SIM_WS}/src --ignore-src -r -y \
    && cd ${EMBR_PHYS_WS} \
    && colcon build --symlink-install \
    && source ${EMBR_PHYS_WS}/install/setup.bash \
    && cd ${EMBR_SIM_WS} \
    && colcon build --symlink-install \
    && chown -R "${USER_UID}:${USER_GID}" ${EMBR_PHYS_WS} ${EMBR_SIM_WS}

COPY docker/canopen-entrypoint.sh /canopen-entrypoint.sh
RUN chmod +x /canopen-entrypoint.sh

USER ${USERNAME}
ENTRYPOINT ["/canopen-entrypoint.sh"]
CMD ["bash"]

LABEL maintainer="Maison Gulyas" \
      description="EMBR physical-description and CANopen simulation environment" \
      version="1.0"
